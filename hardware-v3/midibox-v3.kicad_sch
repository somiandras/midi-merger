	(text "MIDI IN 1/2: 3.5mm TRS Type A (tip = current sink, ring = current source, sleeve not connected). H11L1 Schmitt opto runs from 3V3, no level shifter needed."
		(exclude_from_sim no)
		(at 20.066 20.32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "3638c43b-7cfd-4192-86f8-060f9934e5d5")
	)
	(text "MIDI OUT 1-5: 3.5mm TRS Type A, 5V drive via 74HCT14\n(U3A inverts UART0_TX, U3B-F drive one output each).\nBoard powered from USB-C VBUS. RP2040 core follows the\n'Hardware design with RP2040' minimal example.\nFirmware pins: GPIO21 = UART1 RX (IN1),\nGPIO17 = UART0 RX (IN2), GPIO16 = UART0 TX.\nJ4 = Raspberry Pi 3-pin debug connector (SWCLK, GND, SWDIO)."
		(exclude_from_sim no)
		(at 279.4 40.64 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4770f5ca-97cf-412f-85fa-d5015590892c")
	)
